{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Cors": {
    "Origins": [ "http://localhost:4200", "http://localhost:4000" ]
  },
  "Jwt": {
    "Issuer": "queensin.api",
    "Audience": "queensin.web",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Google": {
    "ClientId": ""
  },
  "Admin": {
    "Email": "admin@queensinn.co.in",
    "DefaultPassword": ""
  },
  "Media": {
    "UploadPath": "uploads",
    "RequestPath": "/uploads",
    "MaxImageBytes": 26214400,
    "MaxVideoBytes": 83886080
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/queensin-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 }
      }
    ]
  }
}
