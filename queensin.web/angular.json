{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "queensin-web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:component": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/cormorant-garamond/latin-300.css",
              "node_modules/@fontsource/cormorant-garamond/latin-400.css",
              "node_modules/@fontsource/cormorant-garamond/latin-500.css",
              "node_modules/@fontsource/cormorant-garamond/latin-600.css",
              "node_modules/@fontsource/cormorant-garamond/latin-300-italic.css",
              "node_modules/@fontsource/cormorant-garamond/latin-400-italic.css",
              "node_modules/@fontsource/cormorant-garamond/latin-500-italic.css",
              "node_modules/@fontsource/jost/latin-300.css",
              "node_modules/@fontsource/jost/latin-400.css",
              "node_modules/@fontsource/jost/latin-500.css",
              "src/styles.css"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": [
                "localhost",
                "127.0.0.1",
                "queensinn.co.in",
                "www.queensinn.co.in"
              ]
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "queensin-web:build:production"
            },
            "development": {
              "buildTarget": "queensin-web:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}